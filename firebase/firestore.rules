rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == userId + '@signtalk.app';

      match /contacts/{contactId} {
        allow read, write: if request.auth != null
          && request.auth.token.email == userId + '@signtalk.app';

        match /messages/{messageId} {
          allow read, write: if request.auth != null
            && request.auth.token.email == userId + '@signtalk.app';
        }
      }
    }
  }
}
